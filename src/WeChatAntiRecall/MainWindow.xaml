<Window x:Class="WeChatAntiRecall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WeChat AntiRecall"
        Width="560"
        Height="420"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#FF111827">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top"
                   Text="微信 4 防撤回"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="White"/>
        <TextBlock DockPanel.Dock="Top"
                   x:Name="StatusText"
                   Margin="0,6,0,12"
                   Foreground="#FF9CA3AF"
                   Text="正在启动..."/>
        <Border CornerRadius="10"
                Background="#FF1F2937"
                BorderBrush="#55374151"
                BorderThickness="1"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogBox"
                         IsReadOnly="true"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#FFE5E7EB"
                         FontFamily="Consolas"
                         FontSize="13"
                         TextWrapping="Wrap"
                         AcceptsReturn="true"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
